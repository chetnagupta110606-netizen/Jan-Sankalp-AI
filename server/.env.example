# Jan-Sankalp AI — Backend environment configuration
# ------------------------------------------------------------------
# Copy this file to `.env` and fill in real values to enable the
# PostgreSQL + PostGIS persistence layer. If NONE of these variables
# are present, the server automatically falls back to the file-backed
# persistence store (server/.data/incidents.json), so the API still
# persists data across restarts with zero external infrastructure.
# ------------------------------------------------------------------

# Service port (default 5000)
PORT=5000

# Option A — single connection string
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/jan_sankalp

# Option B — discrete connection parameters (uncomment to activate)
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=jan_sankalp
# PGUSER=postgres
# PGPASSWORD=postgres